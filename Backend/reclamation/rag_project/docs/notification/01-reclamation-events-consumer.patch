diff --git a/Backend/notification-service/tests/Feature/ReclamationEventsTest.php b/Backend/notification-service/tests/Feature/ReclamationEventsTest.php
new file mode 100644
index 0000000..caac715
--- /dev/null
+++ b/Backend/notification-service/tests/Feature/ReclamationEventsTest.php
@@ -0,0 +1,78 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Services\EventMessageProcessor;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\Support\InteractsWithServices;
+use Tests\TestCase;
+
+class ReclamationEventsTest extends TestCase
+{
+    use InteractsWithServices, RefreshDatabase;
+
+    private function send(array $message): bool
+    {
+        return app(EventMessageProcessor::class)->process('reclamation.events', json_encode($message));
+    }
+
+    private function event(string $event, array $data, string $actorId = 'admin1'): array
+    {
+        return ['event' => $event, 'occurredAt' => '2026-11-11T18:05:00Z', 'actorId' => $actorId, 'data' => $data];
+    }
+
+    private function statusChanged(array $override = []): array
+    {
+        return $this->event('reclamation.status_changed', $override + [
+            'reclamationId' => '507f1f77bcf86cd799439011', 'reference' => 'REC-2026-00001',
+            'studentSub' => 'alice', 'oldStatus' => 'in_progress', 'newStatus' => 'resolved',
+        ]);
+    }
+
+    public function test_queue_is_declared_by_notification(): void
+    {
+        $this->assertContains('reclamation.events', config('services.rabbitmq.queues'));
+    }
+
+    public function test_status_change_notifies_the_student_only(): void
+    {
+        $this->assertTrue($this->send($this->statusChanged()));
+
+        $this->asUser('alice')->getJson('/api/notifications')
+            ->assertJsonPath('data.0.type', 'system')
+            ->assertJsonPath('data.0.data.reference', 'REC-2026-00001')
+            ->assertJsonPath('data.0.data.status', 'resolved');
+        $this->assertDatabaseCount('notifications', 1);
+    }
+
+    public function test_creation_notifies_each_configured_admin_once(): void
+    {
+        config(['services.reclamation.admin_ids' => ['admin1', 'admin2', 'admin1']]);
+
+        $this->assertTrue($this->send($this->event('reclamation.created', [
+            'reclamationId' => '507f1f77bcf86cd799439011', 'reference' => 'REC-2026-00001',
+            'studentSub' => 'alice', 'category' => 'grade',
+        ], 'alice')));
+
+        $this->assertDatabaseCount('notifications', 2);
+        $this->assertDatabaseMissing('notifications', ['user_id' => 'alice']);
+    }
+
+    public function test_creation_without_configured_admins_is_acknowledged_without_notification(): void
+    {
+        config(['services.reclamation.admin_ids' => []]);
+
+        $this->assertTrue($this->send($this->event('reclamation.created', [
+            'reclamationId' => 'r1', 'reference' => 'REC-2026-00001', 'studentSub' => 'alice', 'category' => 'grade',
+        ], 'alice')));
+        $this->assertDatabaseCount('notifications', 0);
+    }
+
+    public function test_unusable_reclamation_messages_are_discarded(): void
+    {
+        $this->assertFalse($this->send($this->statusChanged(['studentSub' => null])));
+        $this->assertFalse($this->send($this->statusChanged(['newStatus' => 'new'])));
+        $this->assertFalse($this->send($this->event('reclamation.deleted', ['reclamationId' => 'r1'])));
+        $this->assertDatabaseCount('notifications', 0);
+    }
+}
