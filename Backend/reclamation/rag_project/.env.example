# Copy this file to .env and adjust (local development).

# DEBUG is OFF when DJANGO_DEBUG is missing or empty (secure default for containers); this file
# turns it on. With DJANGO_DEBUG=False the service refuses to start unless DJANGO_SECRET_KEY is a
# random value of 50+ characters:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------
# Paths: relative = inside this folder, absolute = used as is, empty = the default shown here
# ---------------------------------------------------------------
# SQLite database (empty = db.sqlite3 in this folder). Its folder must already exist.
DJANGO_DB_PATH=
RAG_REGULATION_DIR=data/regulation
RAG_PDF_DIR=data/pdfs
RAG_MAX_UPLOAD_MB=20
RAG_CHROMA_DIR=data/chroma
RAG_ACADEMIC_YEAR=2026-2027

# ---------------------------------------------------------------
# In a container (set by the deployment, not in a .env file; the Dockerfile comes later):
#   DJANGO_DEBUG=False
#   DJANGO_SECRET_KEY=<random, 50+ characters>
#   DJANGO_ALLOWED_HOSTS=<the service's Docker host name>,localhost,127.0.0.1
#   DJANGO_DB_PATH=/app/data/db.sqlite3     # SQLite, Chroma and uploaded PDFs in ONE volume:
#   RAG_CHROMA_DIR=/app/data/chroma         # the database records what is indexed in Chroma
#   RAG_PDF_DIR=/app/data/pdfs
#   RAG_REGULATION_DIR=<read-only dataset shipped in the image, OUTSIDE the volume>
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Chunking / retrieval (tune with: python manage.py eval_rag)
# ---------------------------------------------------------------
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=300
RAG_CANDIDATES=20
RAG_TOP_PAGES=4
RAG_TOP_RULES=6
RAG_TOP_AMBIGUITIES=2
RAG_SEMANTIC_WEIGHT=1.0
RAG_LEXICAL_WEIGHT=1.0
RAG_MIN_SIMILARITY=0.0
RAG_AMBIGUITY_MIN_SIMILARITY=0.5
RAG_HISTORY_MESSAGES=4

# ---------------------------------------------------------------
# Option A (default): everything local with Ollama, free
#   ollama pull bge-m3      (multilingual embeddings: FR / EN / AR)
#   ollama pull llama3.2    (chat model)
# ---------------------------------------------------------------
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# ---------------------------------------------------------------
# Option B: OpenAI
# ---------------------------------------------------------------
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
# EMBED_MODEL=text-embedding-3-small
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------
# Option C: Google Gemini (OpenAI-compatible endpoint), key from https://aistudio.google.com
#   Free tier: 100 embedded texts/minute -> ingestion pauses automatically when it is reached.
#   gemini-2.5-* models are no longer available to new users (404).
# ---------------------------------------------------------------
# EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBED_API_KEY=your-gemini-key
# EMBED_MODEL=gemini-embedding-001
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-3.8-flash
# LLM_REASONING_EFFORT=low     # thinking happens inside the token budget; low keeps answers whole

# Answer length budget (thinking models include their hidden reasoning in it)
# LLM_MAX_TOKENS=2048

# NOTE: if you change EMBED_MODEL, re-run:  python manage.py rebuild_index
