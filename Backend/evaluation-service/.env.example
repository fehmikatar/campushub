# Exemple de configuration locale du service Evaluation.
# Copier ce fichier en ".env" (non committé) et renseigner les valeurs.
# Ne jamais mettre de vraies valeurs dans CE fichier d'exemple.

# Secret JWT (HS256) : chaîne UTF-8 brute (PAS de Base64), minimum 32 octets.
# Doit être identique à celui du User Service (Spring Boot).
JWT_SECRET=

# Issuer exigé dans le token (claim "iss").
JWT_ISSUER=campushub-user-service

# Origines CORS autorisées, séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# URL AMQP du broker RabbitMQ. Laisser vide pour désactiver l'envoi d'événements.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Appel synchrone vers course-service (vérification du cours à la création d'un quiz).
# Si renseignée, cette URL remplace Eureka (utile en Docker), par exemple :
# COURSE_SERVICE_URL=http://localhost:8082
# Laisser vide pour résoudre "course-service" via Eureka.
COURSE_SERVICE_URL=

# Chaîne de connexion SQL Server.
# Variante "user-secrets" : dotnet user-secrets set "JWT_SECRET" "..."
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=EvaluationDB;Trusted_Connection=True;TrustServerCertificate=True;
