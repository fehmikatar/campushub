{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:8084",
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": false,
      "ValidateCertificates": false
    },
    "Instance": {
      "AppName": "evaluation-service",
      "HostName": "localhost",
      "Port": 8084,
      "InstanceId": "evaluation-service:localhost:8084",
      "VipAddress": "evaluation-service",
      "PreferIPAddress": false
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=EvaluationDB;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
