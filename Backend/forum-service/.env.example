PORT=8086
MONGO_URI=mongodb://localhost:27017/campushub_forum
JWT_SECRET=
JWT_ISSUER=campushub-user-service
EUREKA_ENABLED=true
EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_INSTANCE_HOST=localhost


# Notification-service (optionnel : vide = notifications désactivées)
NOTIFICATION_SERVICE_URL=http://localhost:8085
INTERNAL_API_KEY=

RABBITMQ_URL=
RABBITMQ_QUEUE=forum.events

# Appel synchrone Forum -> Course (le cours doit exister avant de créer un sujet)
COURSE_CHECK_ENABLED=false
COURSE_SERVICE_URL=
COURSE_TIMEOUT_MS=3000

# Keycloak : si renseigne, Forum valide les tokens Keycloak (RS256) au lieu de JWT_SECRET
KEYCLOAK_ISSUER_URI=
# Adresse des cles publiques si differente de l'issuer (Docker). Vide = <issuer>/protocol/openid-connect/certs
KEYCLOAK_JWKS_URI=