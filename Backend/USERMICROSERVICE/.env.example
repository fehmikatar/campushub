# CampusHub User Service - environment variables.
# Copy to .env (or export them in your shell) and fill in real values. Never commit a real .env.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# --- MySQL 8.4 ------------------------------------------------------------------------------
# Host/port/name/user default to these values; only DB_PASSWORD is required.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campushub_users
DB_USERNAME=campushub_app
# The password you chose in CREATE USER 'campushub_app' (see README). No default anywhere.
DB_PASSWORD=

# Optional: the whole JDBC URL instead of the parts above (keep the UTC parameters).
# DB_URL=jdbc:mysql://localhost:3306/campushub_users?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true

# --- JWT --------------------------------------------------------------------------------------
# At least 32 bytes. Required outside the local profile. Use a NEW value for CampusHub (never the
# old H&B Travel secret), e.g. generate one with: openssl rand -base64 48
JWT_SECRET=
# Access-token lifetime (ISO-8601). There is no refresh token: after this, log in again.
JWT_ACCESS_TOKEN_TTL=PT1H

# --- First administrator (optional) -----------------------------------------------------------
# Created at startup only if both are set and no administrator exists yet. Password: 12+ chars.
CAMPUSHUB_ADMIN_EMAIL=
CAMPUSHUB_ADMIN_PASSWORD=

# --- Frontend ---------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
