PORT=8082
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=course_db

EUREKA_ENABLED=true
EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_INSTANCE_HOST=localhost

RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Meme secret que le User Service (HS256, minimum 32 octets).
# Obligatoire uniquement en mode Legacy, si KEYCLOAK_ISSUER_URI n'est pas defini.
# Mode Legacy (HS256) - utilise si KEYCLOAK_ISSUER_URI n'est pas defini
JWT_SECRET=
JWT_ISSUER=campushub-user-service

# Mode Keycloak (RS256) - si defini, active la validation via Keycloak
# Issuer du token (doit correspondre au "iss" du JWT Keycloak)
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/campushub
# URI des cles JWKS (optionnel, defaut: KEYCLOAK_ISSUER_URI/protocol/openid-connect/certs)
# En Docker: http://keycloak:8080/realms/campushub/protocol/openid-connect/certs
KEYCLOAK_JWKS_URI=

# URL de l'Evaluation Service (priorité sur Eureka, utile en Docker)
# Ex: http://evaluation-service:8084
EVALUATION_SERVICE_URL=
